    given-names: Dahee
    affiliation: "Department of Environmental Engineering, Ajou University"
    email: dahee02@ajou.ac.kr
  - family-names: Jung
    given-names: Seung-ho
    affiliation: "Department of Environmental and Safety Engineering, Ajou University"
    email: processsafety@ajou.ac.kr
    orcid: "https://orcid.org/0000-0001-8339-441X"
keywords:
  - GHS hazard classification
  - decision-threshold calibration
  - class imbalance
  - graph neural network
  - multi-label classification
  - molecular representation learning
  - QSAR
